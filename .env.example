# Claude (model claude-sonnet-4-6)
ANTHROPIC_API_KEY=

# LangGraph checkpointer (the Postgres container from docker-compose.yml)
POSTGRES_URI=postgresql://agent:agent@localhost:5432/agent

# Self-hosted Langfuse (keys are created by the headless init in docker-compose.yml).
# Leave the keys empty to disable tracing. UI login: admin@example.com / admin-password
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev
LANGFUSE_BASE_URL=http://localhost:3000
